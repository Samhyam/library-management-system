{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "College full-stack project: Library Management System (Express + SQLite + vanilla JS)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:report": "node scripts/test-report.js",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
